# Copy to functions/.env before deploying.
# Must match your Firestore database location (Firebase console >
# Firestore > the location shown at the top), e.g. us-central1, europe-west1,
# me-central1. For multi-region "nam5" use us-central1; for "eur3" use europe-west1.
FUNCTIONS_REGION=us-central1

# TURN relay for calls (optional; needs a TURN server or provider).
# Comma-separated; prefer TURNS (TLS) on 5349/443 for restrictive networks.
# The shared secret is NOT stored here: firebase functions:secrets:set TURN_SHARED_SECRET
TURN_URLS=
# Firebase App Check for callable functions. Keep false while collecting
# metrics; set true once almost all requests are verified.
ENFORCE_APP_CHECK=false
