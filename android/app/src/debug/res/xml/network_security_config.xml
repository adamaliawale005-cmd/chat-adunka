<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP to the Firebase emulators that
     automated tests run on the host computer (10.0.2.2 as seen from the
     Android emulator). Everything else stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
