rules_version = '2';

// AduChat Firestore security rules.
//
// Data model (see docs/ARCHITECTURE.md):
//   users/{uid}                    public profile (no phone number)
//   users/{uid}/private/{doc}      phone, email, settings (owner only)
//   users/{uid}/devices/{token}    FCM tokens (owner only)
//   users/{uid}/blocked/{otherUid} block list (owner only)
//   users/{uid}/calls/{callId}     call history entries
//   usernames/{username}           unique username -> uid (get only)
//   phoneIndex/{e164}              phone -> uid for opted-in users (get only)
//   directory/{uid}                searchable name/username (opt-in)
//   chats/{chatId}                 direct ("uidA_uidB") or group chat
//   chats/{chatId}/messages/{id}   messages
//   chats/{chatId}/blobs/{id}      inline attachments (free-plan images/voice)
//   calls/{callId}                 WebRTC call signaling
//   calls/{callId}/candidates/{id} ICE candidates
//   reports/{id}                   abuse reports (write only)
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    function hasBlocked(owner, other) {
      return exists(/databases/$(database)/documents/users/$(owner)/blocked/$(other));
    }

    // Direct chat ids are exactly two non-empty user ids, sorted, joined
    // with "_". Group chat ids never contain "_". Any other id is refused.
    function isDirectId(chatId) {
      let p = chatId.split('_');
      return p.size() == 2 && p[0].size() > 0 && p[1].size() > 0 && p[0] < p[1];
    }
    function isGroupId(chatId) { return !chatId.matches('.*_.*'); }
    function inDirect(chatId) { return isDirectId(chatId) && me() in chatId.split('_'); }
    function peerOf(chatId) {
      let p = chatId.split('_');
      return p[0] == me() ? p[1] : p[0];
    }
    function chatPath(chatId) { return /databases/$(database)/documents/chats/$(chatId); }
    function chat(chatId) { return get(chatPath(chatId)).data; }
    function chatAfter(chatId) { return getAfter(chatPath(chatId)).data; }
    function isMember(chatId) {
      return signedIn() && (inDirect(chatId) || (isGroupId(chatId) && me() in chat(chatId).members));
    }
    // Membership as it will be after the current write/batch. For direct
    // chats the chat document must actually exist (no messages into
    // conversations that were never created).
    function isMemberAfter(chatId) {
      return signedIn() && (
        (inDirect(chatId) && existsAfter(chatPath(chatId)) && chatAfter(chatId).type == 'direct')
        || (isGroupId(chatId) && me() in chatAfter(chatId).members));
    }
    function isGroupAdmin(chatId) {
      return signedIn() && isGroupId(chatId) && me() in chat(chatId).admins;
    }
    // Admin before or after this write (covers creating a group and an
    // admin stepping down in the same batch as the system message).
    function wasOrIsGroupAdmin(chatId) {
      return (exists(chatPath(chatId)) && me() in chat(chatId).get('admins', []))
        || me() in chatAfter(chatId).get('admins', []);
    }
    function neitherBlocked(a, b) { return !hasBlocked(a, b) && !hasBlocked(b, a); }
    function userExists(uid) { return exists(/databases/$(database)/documents/users/$(uid)); }

    // ---------- users ----------
    function validUser(userId) {
      let d = incoming();
      let usernameChanged = resource == null || d.get('username', '') != resource.data.get('username', '');
      return d.keys().hasOnly(['uid', 'displayName', 'displayNameLower', 'username', 'usernameLower',
                               'about', 'photoBase64', 'createdAt', 'updatedAt', 'lastSeen', 'online'])
        && d.uid == userId
        && isStr(d.displayName, 1, 50)
        && (!('about' in d) || isStr(d.about, 0, 140))
        && (!('photoBase64' in d) || isStr(d.photoBase64, 1, 200000))
        && (!('online' in d) || d.online is bool)
        && (!('username' in d) || (
              d.username.matches('^[a-z][a-z0-9_]{2,19}$')
              && (!usernameChanged || getAfter(/databases/$(database)/documents/usernames/$(d.username)).data.uid == userId)));
    }

    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && me() == userId && validUser(userId);
      allow delete: if signedIn() && me() == userId;

      match /private/{docId} {
        allow read, delete: if signedIn() && me() == userId;
        allow create, update: if signedIn() && me() == userId
          && incoming().keys().hasOnly(['phoneNumber', 'email', 'discoverableByPhone',
                                        'showInDirectory', 'showLastSeen', 'readReceipts',
                                        'contactSync', 'notifications', 'mutedChats']);
      }

      match /devices/{token} {
        allow read, write: if signedIn() && me() == userId;
      }

      match /blocked/{otherId} {
        allow read, delete: if signedIn() && me() == userId;
        allow create, update: if signedIn() && me() == userId && otherId != userId
          && incoming().keys().hasOnly(['uid', 'createdAt']) && incoming().uid == otherId;
      }

      // Call history. The caller also writes the callee's entry so that
      // missed calls appear even if the callee's app was closed.
      match /calls/{callId} {
        function callAfter() { return getAfter(/databases/$(database)/documents/calls/$(callId)).data; }
        allow read, delete: if signedIn() && me() == userId;
        allow create, update: if signedIn()
          && (me() == userId || (callAfter().callerId == me() && userId in callAfter().members))
          && incoming().keys().hasOnly(['callId', 'peerId', 'type', 'direction', 'status',
                                        'createdAt', 'answeredAt', 'endedAt', 'durationSec', 'seen'])
          && incoming().callId == callId;
      }
    }

    // ---------- usernames, phone index, directory ----------
    // A username can only be claimed in the same write that puts it into
    // the claimant's profile, so one account cannot reserve many names.
    function profileUsesUsername(username) {
      return getAfter(/databases/$(database)/documents/users/$(me())).data.get('username', '') == username;
    }
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && username.matches('^[a-z][a-z0-9_]{2,19}$')
        && incoming().keys().hasOnly(['uid', 'createdAt']) && incoming().uid == me()
        && profileUsesUsername(username);
      // Re-claiming your own username (e.g. after a failed save) is allowed.
      allow update: if signedIn() && existing().uid == me()
        && incoming().keys().hasOnly(['uid', 'createdAt']) && incoming().uid == me()
        && profileUsesUsername(username);
      allow delete: if signedIn() && existing().uid == me();
    }

    // Lookup by exact phone number only; listing is impossible, so phone
    // numbers cannot be harvested with a query.
    match /phoneIndex/{phone} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.auth.token.phone_number == phone
        && incoming().keys().hasOnly(['uid', 'updatedAt']) && incoming().uid == me();
      allow delete: if signedIn() && existing().uid == me();
    }

    match /directory/{userId} {
      allow get: if signedIn();
      // Search pages are limited, so the directory cannot be dumped in one query.
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 50;
      allow create, update: if signedIn() && me() == userId
        && incoming().keys().hasOnly(['uid', 'displayName', 'displayNameLower', 'username',
                                      'usernameLower', 'updatedAt'])
        && incoming().uid == userId
        && isStr(incoming().displayName, 1, 50)
        && isStr(incoming().displayNameLower, 1, 50)
        && isStr(incoming().get('usernameLower', ''), 0, 20);
      allow delete: if signedIn() && me() == userId;
    }

    // ---------- rules version probe ----------
    // The app reads rulesVersion/<version> (the document does not need to
    // exist). If the read is refused, the rules published in the Firebase
    // console are older than the app expects. Nothing is stored here.
    match /rulesVersion/{version} {
      allow get: if signedIn() && version == '2026-10-27';
      allow list, write: if false;
    }

    // ---------- abuse reports ----------
    match /reports/{reportId} {
      allow create: if signedIn()
        && incoming().keys().hasOnly(['reporterId', 'reportedUid', 'reason', 'details',
                                      'chatId', 'messageId', 'createdAt'])
        && incoming().reporterId == me()
        && isStr(incoming().reportedUid, 1, 128)
        && incoming().reportedUid != me()
        && incoming().reason in ['spam', 'harassment', 'inappropriate', 'impersonation', 'violence', 'scam', 'other']
        && isStr(incoming().get('details', ''), 0, 1000)
        && isStr(incoming().get('chatId', 'x'), 1, 200)
        && isStr(incoming().get('messageId', 'x'), 1, 200)
        && incoming().createdAt == request.time;
      allow read, update, delete: if false;
    }

    // ---------- chats ----------
    function summaryKeys() {
      return ['lastMessage', 'lastMessageType', 'lastSenderId', 'lastMessageAt', 'lastMessageId',
              'updatedAt', 'typing', 'unread'];
    }
    function groupKeys() {
      return summaryKeys().concat(['type', 'name', 'description', 'photoBase64', 'createdBy',
              'members', 'admins', 'onlyAdminsCanSend', 'onlyAdminsEditInfo', 'createdAt']);
    }
    // A new last-message summary must come from the writer and belong to a
    // message that exists after this batch (it cannot be forged on its own).
    function validSummary(chatId) {
      return !('lastMessage' in changed())
        || (incoming().lastSenderId == me()
            && isStr(incoming().lastMessage, 0, 4100)
            && existsAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(incoming().lastMessageId)));
    }
    function onlyOwnTyping() {
      return !('typing' in changed())
        || incoming().typing.diff(existing().get('typing', {})).affectedKeys().hasOnly([me()]);
    }
    // Resetting only your own unread counter to 0 (allowed even after a block).
    function onlyOwnUnreadReset() {
      return changed().hasOnly(['unread'])
        && incoming().unread.diff(existing().get('unread', {})).affectedKeys().hasOnly([me()])
        && incoming().unread[me()] == 0;
    }
    function validGroupShape() {
      let d = incoming();
      return d.keys().hasOnly(groupKeys())
        && isStr(d.name, 1, 60)
        && isStr(d.get('description', ''), 0, 500)
        && isStr(d.get('photoBase64', 'x'), 1, 200000)
        && d.members is list && d.admins is list
        && d.members.size() >= 1 && d.members.size() <= 256
        && d.members.hasAll(d.admins)
        && d.get('onlyAdminsCanSend', false) is bool
        && d.get('onlyAdminsEditInfo', false) is bool;
    }

    match /chats/{chatId} {
      allow get: if isMember(chatId);
      allow list: if signedIn() && me() in resource.data.members;

      allow create: if signedIn() && (
        // direct chat: created by its first message (same batch), only with
        // an existing user who has not blocked the sender (and vice versa)
        (inDirect(chatId)
          && incoming().keys().hasOnly(summaryKeys().concat(['type', 'members']))
          && incoming().type == 'direct'
          && incoming().members.size() == 2
          && incoming().members.hasAll(chatId.split('_'))
          && userExists(peerOf(chatId))
          && neitherBlocked(me(), peerOf(chatId))
          && incoming().lastSenderId == me()
          && isStr(incoming().get('lastMessage', ''), 0, 4100))
        ||
        // group chat
        (isGroupId(chatId)
          && incoming().type == 'group'
          && incoming().createdBy == me()
          && me() in incoming().members
          && me() in incoming().admins
          && incoming().members.size() >= 2
          && validGroupShape()));

      allow update: if signedIn()
        && me() in existing().members
        && incoming().type == existing().type
        && incoming().get('createdBy', '') == existing().get('createdBy', '')
        && onlyOwnTyping()
        && (
          // direct chats: summary, typing, unread - but nothing at all
          // while either person has blocked the other (except clearing
          // your own unread counter)
          (existing().type == 'direct'
            && changed().hasOnly(summaryKeys())
            && (onlyOwnUnreadReset()
                || (neitherBlocked(me(), peerOf(chatId)) && validSummary(chatId))))
          ||
          // group members: last-message summary, typing, unread counters
          (existing().type == 'group' && changed().hasOnly(summaryKeys()) && validSummary(chatId))
          ||
          // group admins: members, admins, name, photo, settings
          (existing().type == 'group' && me() in existing().admins
            && validSummary(chatId)
            && incoming().members.size() >= 1
            && validGroupShape())
          ||
          // group member leaving
          (existing().type == 'group'
            && changed().hasOnly(['members', 'admins', 'updatedAt', 'unread', 'typing'])
            && incoming().members.toSet() == existing().members.toSet().difference([me()].toSet())
            && incoming().admins.toSet() == existing().admins.toSet().difference([me()].toSet()))
          ||
          // group member editing info, when the group allows it
          (existing().type == 'group' && !existing().get('onlyAdminsEditInfo', false)
            && changed().hasOnly(['name', 'photoBase64', 'description', 'updatedAt'])
            && isStr(incoming().name, 1, 60)
            && isStr(incoming().get('description', ''), 0, 500)
            && isStr(incoming().get('photoBase64', 'x'), 1, 200000))
        );

      allow delete: if signedIn() && existing().type == 'group' && me() in existing().admins;

      // ---------- messages ----------
      // System messages are machine-readable group events. Events that
      // describe an admin action can only be written by an admin; any
      // member may announce that they left, and rename notices follow the
      // group's "who can edit info" setting.
      function systemEvent() { return incoming().text.split(':')[0]; }
      function validSystemMessage() {
        let ev = systemEvent();
        return isGroupId(chatId)
          && isStr(incoming().text, 1, 3000)
          && ev in ['created', 'added', 'removed', 'admin_added', 'admin_removed', 'renamed', 'left']
          && (ev == 'left'
              || wasOrIsGroupAdmin(chatId)
              || (ev == 'renamed' && !chatAfter(chatId).get('onlyAdminsEditInfo', false)));
      }

      match /messages/{messageId} {
        allow read: if isMember(chatId);

        allow create: if isMemberAfter(chatId)
          && incoming().keys().hasOnly(['senderId', 'receiverId', 'type', 'text', 'attachment',
                                        'replyTo', 'forwarded', 'status', 'readBy',
                                        'clientCreatedAt', 'createdAt'])
          && incoming().senderId == me()
          && incoming().type in ['text', 'image', 'video', 'audio', 'file', 'system']
          && isStr(incoming().get('text', ''), 0, 4000)
          && (incoming().type != 'text' || incoming().text.size() > 0)
          && incoming().createdAt == request.time
          // client time may be in the past (offline queue) but not far in
          // the future (which would pin a message to the top)
          && incoming().clientCreatedAt is timestamp
          && incoming().clientCreatedAt < request.time + duration.value(1, 'h')
          && (!('attachment' in incoming()) || (incoming().attachment is map && incoming().attachment.size() <= 20))
          && (!('replyTo' in incoming()) || (incoming().replyTo is map && incoming().replyTo.size() <= 10))
          && (!('forwarded' in incoming()) || incoming().forwarded is bool)
          && (incoming().type != 'system' || validSystemMessage())
          && (
            (isDirectId(chatId)
              && incoming().type != 'system'
              && incoming().receiverId == peerOf(chatId)
              && incoming().status == 'sent'
              && !('readBy' in incoming())
              && neitherBlocked(me(), incoming().receiverId))
            ||
            (isGroupId(chatId)
              && !('receiverId' in incoming())
              && !('status' in incoming())
              && incoming().get('readBy', []).size() == 0
              && (incoming().type == 'system'
                  || !chatAfter(chatId).get('onlyAdminsCanSend', false)
                  || me() in chatAfter(chatId).admins))
          );

        allow update: if isMember(chatId) && (
          // receiver confirms delivery / read (direct chats)
          (isDirectId(chatId) && me() == existing().get('receiverId', '')
            && changed().hasOnly(['status', 'deliveredAt', 'readAt'])
            && incoming().status in ['delivered', 'read'])
          ||
          // group member marks as read
          (isGroupId(chatId) && me() != existing().senderId
            && changed().hasOnly(['readBy'])
            && incoming().readBy.toSet() == existing().get('readBy', []).toSet().union([me()].toSet()))
          ||
          // sender edits a text message within 48 hours
          (me() == existing().senderId && existing().type == 'text'
            && !existing().get('deleted', false)
            && changed().hasOnly(['text', 'edited', 'editedAt'])
            && isStr(incoming().text, 1, 4000)
            && incoming().edited == true
            && request.time < existing().createdAt + duration.value(2, 'd'))
          ||
          // sender deletes for everyone
          (me() == existing().senderId && existing().type != 'system'
            && changed().hasOnly(['deleted', 'deletedAt', 'text', 'attachment', 'replyTo'])
            && incoming().deleted == true
            && incoming().get('text', '') == ''
            && !('attachment' in incoming()))
          ||
          // anyone hides a message for themselves
          (changed().hasOnly(['hiddenFor'])
            && incoming().hiddenFor.toSet() == existing().get('hiddenFor', []).toSet().union([me()].toSet()))
        );

        // Only used when a group admin deletes the whole group.
        allow delete: if isGroupAdmin(chatId);
      }

      // Inline attachments (images / voice notes) for the free plan.
      match /blobs/{blobId} {
        allow read: if isMember(chatId);
        allow create: if isMemberAfter(chatId)
          && (!isDirectId(chatId) || neitherBlocked(me(), peerOf(chatId)))
          && incoming().keys().hasOnly(['senderId', 'data', 'mime', 'size', 'createdAt'])
          && incoming().senderId == me()
          && isStr(incoming().data, 1, 950000)
          && incoming().mime is string
          && incoming().mime.matches('^(image|audio|video)/[a-z0-9.+-]{1,60}$')
          && incoming().mime != 'image/svg+xml'
          && incoming().size is int && incoming().size > 0 && incoming().size <= 712500;
        allow update: if false;
        allow delete: if signedIn() && (existing().senderId == me() || isGroupAdmin(chatId));
      }
    }

    // ---------- calls (WebRTC signaling) ----------
    function validSdp(d) {
      return d is map && d.keys().hasOnly(['sdp', 'type']) && isStr(d.sdp, 1, 100000)
        && d.type in ['offer', 'answer'];
    }

    match /calls/{callId} {
      allow get: if signedIn() && me() in existing().members;
      allow list: if signedIn() && (existing().calleeId == me() || existing().callerId == me());

      allow create: if signedIn()
        && incoming().keys().hasOnly(['callerId', 'calleeId', 'members', 'type', 'status',
                                      'offer', 'offerVersion', 'createdAt', 'updatedAt'])
        && incoming().callerId == me()
        && isStr(incoming().calleeId, 1, 128)
        && incoming().calleeId != me()
        && incoming().members == [incoming().callerId, incoming().calleeId]
        && incoming().type in ['audio', 'video']
        && incoming().status == 'ringing'
        && (!('offer' in incoming()) || validSdp(incoming().offer))
        && userExists(incoming().calleeId)
        && neitherBlocked(me(), incoming().calleeId);

      allow update: if signedIn() && me() in existing().members
        && incoming().members == existing().members
        && incoming().callerId == existing().callerId
        && incoming().calleeId == existing().calleeId
        && incoming().type == existing().type
        && changed().hasOnly(['status', 'offer', 'offerVersion', 'answer', 'answerVersion',
                              'answeredAt', 'endedAt', 'endedBy', 'updatedAt'])
        && (!('offer' in changed()) || (me() == existing().callerId && validSdp(incoming().offer)))
        && (!('answer' in changed()) || (me() == existing().calleeId && validSdp(incoming().answer)))
        && incoming().status in ['ringing', 'accepted', 'rejected', 'ended', 'missed', 'cancelled', 'busy'];

      allow delete: if false;

      match /candidates/{candidateId} {
        function call() { return get(/databases/$(database)/documents/calls/$(callId)).data; }
        allow read: if signedIn() && me() in call().members;
        allow create: if signedIn() && me() in call().members
          && incoming().keys().hasOnly(['from', 'candidate', 'sdpMid', 'sdpMLineIndex', 'createdAt'])
          && incoming().from == me()
          && isStr(incoming().get('candidate', ''), 0, 2000);
        allow update, delete: if false;
      }
    }
  }
}
