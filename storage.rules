rules_version = '2';

// AduChat Cloud Storage rules. Storage needs the Blaze plan; the app only
// uses it when the STORAGE_ENABLED build variable is "true".
//
// Files live at chats/{chatId}/{senderUid}/{fileName}. Only members of the
// chat can read them; only the sender can upload or delete them.
// Uploads are refused while either person in a direct chat has blocked
// the other. Only common media and office document types are accepted:
// executables, installers (APK), HTML and SVG (script carriers) and
// unknown binary types are refused.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // Same id forms as firestore.rules.
    function isDirectId(chatId) {
      let p = chatId.split('_');
      return p.size() == 2 && p[0].size() > 0 && p[1].size() > 0 && p[0] < p[1];
    }
    function isGroupId(chatId) { return !chatId.matches('.*_.*'); }
    function peerOf(chatId) {
      let p = chatId.split('_');
      return p[0] == me() ? p[1] : p[0];
    }

    function isMember(chatId) {
      return signedIn() && (
        (isDirectId(chatId) && me() in chatId.split('_'))
        || (isGroupId(chatId)
            && me() in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.members));
    }

    function directOpen(chatId) {
      return !isDirectId(chatId) || (
        !firestore.exists(/databases/(default)/documents/users/$(peerOf(chatId))/blocked/$(me()))
        && !firestore.exists(/databases/(default)/documents/users/$(me())/blocked/$(peerOf(chatId))));
    }

    function ctype() { return request.resource.contentType; }
    function fsize() { return request.resource.size; }
    function mb(n) { return n * 1024 * 1024; }

    function allowedUpload() {
      return (ctype().matches('image/(jpeg|png|webp|gif|heic|heif)') && fsize() <= mb(15))
        || (ctype().matches('audio/(mp4|aac|mpeg|ogg|wav|webm|x-m4a)') && fsize() <= mb(25))
        || (ctype().matches('video/(mp4|quicktime|3gpp|webm)') && fsize() <= mb(50))
        || ((ctype() == 'application/pdf'
             || ctype() == 'application/msword'
             || ctype() == 'application/vnd.ms-excel'
             || ctype() == 'application/vnd.ms-powerpoint'
             || ctype().matches('application/vnd[.]openxmlformats-officedocument[.](wordprocessingml[.]document|spreadsheetml[.]sheet|presentationml[.]presentation)')
             || ctype() == 'application/zip'
             || ctype() == 'text/plain'
             || ctype() == 'text/csv')
            && fsize() <= mb(50));
    }

    match /chats/{chatId}/{senderId}/{fileName} {
      allow read: if isMember(chatId);
      allow create: if isMember(chatId)
        && me() == senderId
        && fileName.size() <= 200
        && !fileName.lower().matches('.*[.](apk|aab|exe|msi|bat|cmd|com|scr|js|jar|sh|ps1|vbs|dll|html?|svg|xapk)$')
        && fsize() > 0
        && allowedUpload()
        && directOpen(chatId);
      allow update: if false;
      allow delete: if signedIn() && me() == senderId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
